{
  "name": "Openlytic.Backend.API.Server",
  "version": "1.0.0",
  "description": "Openlytic control plane - Auth, GraphQL API, organizations, integrations, send orchestration",
  "main": "dist/index.mjs",
  "author": "Openlytic",
  "license": "ISC",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run lint && npm run typecheck",
    "build": "node scripts/build.mjs",
    "predev": "npm run lint",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:sync": "tsx src/db-sync.ts",
    "lint": "eslint --quiet . --ignore-pattern build/ --ignore-pattern dist/",
    "lint-fix": "eslint --quiet . --fix --ignore-pattern build/ --ignore-pattern dist/",
    "format": "prettier . --write",
    "pre-commit": "lint-staged --allow-empty",
    "prepare": "husky"
  },
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@graphql-tools/load-files": "^7.0.1",
    "@graphql-tools/merge": "^9.1.1",
    "@graphql-tools/schema": "^10.0.0",
    "@graphql-tools/utils": "^10.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "graphql": "^16.9.0",
    "graphql-ws": "^6.0.6",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.15",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/parser": "^7.18.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.23.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.5",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,css,scss,json,html,graphql}": [
      "prettier --write"
    ]
  }
}
